# 复制这个文件为 .env，再按自己的环境修改。.env 已被 .gitignore 排除，不会上传。

# 数据库连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=library

# JWT 密钥。生产环境务必换成随机值，可用下面命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# 服务监听地址与端口。注意：实际监听由启动命令的 --host / --port 决定，
# 这里的值只是给代码读，改这里不会改变 uvicorn 的监听地址。
SERVER_HOST=127.0.0.1
SERVER_PORT=8000